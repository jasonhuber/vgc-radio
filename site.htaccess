Options -Indexes
ServerSignature Off

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "geolocation=(self), bluetooth=(self)"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
  # /coverage/ is the one page that reaches off-origin, and only for two things:
  # OpenStreetMap raster tiles and Open-Meteo ground-elevation lookups. Scripts stay
  # 'self' — Leaflet is vendored into the page's own directory — so this widens
  # images and fetch targets only, and only for that path. Every programmer page
  # keeps the strict policy above.
  <If "%{REQUEST_URI} =~ m#^/coverage/#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.tile.openstreetmap.org; connect-src 'self' https://api.open-meteo.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
  </If>
  # /aprs/ needs the same OpenStreetMap tiles and nothing else off-origin.
  <If "%{REQUEST_URI} =~ m#^/aprs/#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.tile.openstreetmap.org; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
  </If>

  <FilesMatch "^(index\.html|sw\.js)$">
    Header always set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(svg|webmanifest)$">
    Header always set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
